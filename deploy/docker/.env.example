# labor.fun — plain-Docker deployment config.
#
# Copy to `deploy/docker/.env` and fill in. Compose reads this file for the
# ${...} values below AND mounts it at /app/.env, where the orchestrator reads
# secrets from it directly (src/env.ts). Never commit a filled-in copy.
#
# This lists what THIS deployment shape needs. Every other knob — channels,
# integrations, budgets, retention — is documented in the repo-root
# `.env.example` and can be added to this same file.

# --- Required ---------------------------------------------------------------

# Selects profiles/<name>/. Must match the profile you seeded into the
# labor-profiles volume (see README.md); the orchestrator exits if it is missing.
LABOR_PROFILE=acme

# --- Images -----------------------------------------------------------------
# Published by .github/workflows/container.yml on every push to main, linux/amd64.
# Pin to :<sha> instead of :latest for reproducible deploys. A private GHCR
# package needs `docker login ghcr.io` on the host first.
ORCHESTRATOR_IMAGE=ghcr.io/breadchaincoop/nanoclaw-orchestrator:latest
AGENT_IMAGE=ghcr.io/breadchaincoop/nanoclaw-agent:latest

# --- Credential proxy -------------------------------------------------------
# The address agent containers reach the proxy on. This must be the docker
# bridge gateway — confirm yours with:
#   docker network inspect bridge -f '{{(index .IPAM.Config 0).Gateway}}'
CREDENTIAL_PROXY_BIND_IP=172.17.0.1
CREDENTIAL_PROXY_PORT=3001
# Optional but recommended: requires agent containers to present this token,
# so another container on the bridge cannot borrow the credential.
#CREDENTIAL_PROXY_AUTH_TOKEN=

# --- Anthropic credential (set exactly one) ---------------------------------
# API key (pay-per-use), or an OAuth token from `claude setup-token` for a
# Claude Pro/Max subscription. Plain `claude auth login` tokens expire within
# hours and will not survive on a 24/7 service.
ANTHROPIC_API_KEY=
#CLAUDE_CODE_OAUTH_TOKEN=

# --- Channels (set the ones you use; each auto-enables when present) --------
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
#TELEGRAM_BOT_TOKEN=
#DISCORD_BOT_TOKEN=

# --- KB dashboard (only used with `--profile kb`) ---------------------------
# KB_SUPERADMINS gates the /admin credentials page. Create the users file at
# profiles/<LABOR_PROFILE>/kb-users.json as {"username":"password"}.
KB_PORT=8080
KB_ADMINS=
KB_SUPERADMINS=

# --- Capacity ---------------------------------------------------------------
# Agent containers run at most this many at once; further groups queue. Each
# carries Chromium, so budget roughly 1 GB apiece — lower this on small hosts.
MAX_CONCURRENT_CONTAINERS=5
# How long an agent container stays warm after its last reply, as plain integer
# milliseconds — no units or separators. Anything else falls back to 1800000.
IDLE_TIMEOUT=1800000
# Leave unset: the orchestrator finds itself by hostname, which works even when
# a container UI renames it. Set only if you give it a custom hostname.
#DOCKER_SELF_CONTAINER=

# --- Misc -------------------------------------------------------------------
TZ=UTC
LOG_LEVEL=info
